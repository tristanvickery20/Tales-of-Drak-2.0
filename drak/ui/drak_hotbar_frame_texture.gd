extends RefCounted
class_name DrakHotbarFrameTexture

const FRAME_SOURCE_SIZE := Vector2(450, 143)
const PNG_BASE64 := ""

static func create_texture() -> Texture2D:
	var bytes := Marshalls.base64_to_raw(PNG_BASE64)
	var image := Image.new()
	var err := image.load_png_from_buffer(bytes)
	if err != OK:
		push_error("Stage 4C hotbar frame failed to load.")
		return null
	return ImageTexture.create_from_image(image)
